{
  "name": "smart-market-watchlist-backend",
  "version": "1.0.0",
  "description": "Production-grade backend service for Smart Market Watchlist",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/generatePrisma.cjs && tsc",
    "start": "node dist/index.js",
    "postinstall": "node scripts/generatePrisma.cjs",
    "prisma:generate": "node scripts/generatePrisma.cjs --force",
    "kill:backend": "node scripts/killBackend.cjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-historical-demo": "tsx prisma/seedHistoricalDemoData.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/node": "^22.20.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}