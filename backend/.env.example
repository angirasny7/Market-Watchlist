# Smart Market Watchlist Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_market_watchlist?schema=public"

# JSON Web Token Secret Key & Expiration
JWT_SECRET="smart_market_watchlist_jwt_secret_key_2026_super_secure_production_grade"
JWT_EXPIRES_IN="180d"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
