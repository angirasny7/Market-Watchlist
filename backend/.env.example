# Smart Market Watchlist - Backend Environment Configuration

# Server Environment
PORT=5000
NODE_ENV=production

# Database (Neon PostgreSQL connection string with SSL required)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-cool-sample.region.neon.tech/smart_market_watchlist?sslmode=require

# Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_string
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins, or * for open access
# Example: https://smart-market-watchlist.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-frontend.vercel.app

# Intelligence & Market Data Providers
MARKET_PROVIDER=yahoo
NEWS_PROVIDER=rss
NEWS_API_KEY=
